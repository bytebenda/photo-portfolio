---
// The whole page: hiding header with the Filter button, the square grid, the footer
// and the photo viewer. On /photo/<slug> the viewer is rendered open.
import { loadContent } from '../lib/content.mjs';
import site from '../site.config.mjs';

interface Props {
  openSlug?: string;
}
const { openSlug } = Astro.props;
const { photos, categories, styles, years, locations } = await loadContent();

const srcset = (list: { w: number; url: string }[]) => list.map((s) => `${s.url} ${s.w}w`).join(', ');
const TILE_SIZES = '(max-width: 640px) 33vw, (max-width: 1024px) 25vw, (max-width: 1799px) 20vw, 17vw';

// Location is nested: a country with places, or a single leaf (a country whose
// only place is Other, or the top-level Other). Shown once a real country exists.
type Row = { id: string; label: string; places?: { id: string; label: string }[] };
const locationRows: Row[] = locations.map((c) =>
  c.places.length === 0 ? { id: c.id, label: c.label } : c.places.length === 1 && c.places[0].label === 'Other' ? { id: c.places[0].id, label: c.label } : c,
);
const hasLocations = locations.some((c) => c.places.length > 0);

const groups: { key: string; label: string; options: Row[] }[] = [
  ...(hasLocations ? [{ key: 'loc', label: 'Location', options: locationRows }] : []),
  { key: 'cat', label: 'Categories', options: categories.map((c) => ({ id: c.id, label: c.label })) },
  { key: 'year', label: 'Year', options: years.map((y) => ({ id: String(y.id), label: y.label })) },
  { key: 'style', label: 'Style', options: styles.map((s) => ({ id: s.id, label: s.label })) },
];

// Location text for the viewer details: "Pajottenland, Belgium", or just the
// country for its Other. Photos outside a country folder have none.
const placeNames = new Map<string, string>();
for (const c of locations) for (const pl of c.places) placeNames.set(pl.id, pl.label === 'Other' ? c.label : `${pl.label}, ${c.label}`);
const placeOf = (p: (typeof photos)[number]) => p.locations.map((id) => placeNames.get(id)).filter(Boolean).join('; ') || null;

const clientPhotos = photos.map((p) => ({
  slug: p.slug,
  title: p.title,
  cat: p.categories,
  year: p.year === null ? [] : [String(p.year)],
  style: p.style ? [p.style] : [],
  loc: p.locations,
  ar: Number(p.ar.toFixed(4)),
  focus: p.focus,
  preview: p.images.preview.url,
  avif: srcset(p.images.large.avif),
  webp: srcset(p.images.large.webp),
  fallback: p.images.large.webp[0].url,
  camera: p.source.camera ?? null,
  lens: p.source.lens ?? null,
  place: placeOf(p),
}));

const openIndex = openSlug ? photos.findIndex((p) => p.slug === openSlug) : -1;
const open = openIndex >= 0 ? photos[openIndex] : null;
const prev = open ? photos[(openIndex - 1 + photos.length) % photos.length] : null;
const next = open ? photos[(openIndex + 1) % photos.length] : null;
const openPlace = open ? placeOf(open) : null;
const hasInfo = !!open && !!(openPlace || open.source.camera || open.source.lens);

const data = {
  siteTitle: site.name,
  groups: groups.map((g) => ({ key: g.key, options: g.options.flatMap((o) => (o.places ? o.places.map((pl) => pl.id) : [o.id])) })),
  photos: clientPhotos,
  open: open ? open.slug : null,
};
const year = new Date().getFullYear();
---

<header class="header" id="header">
  <a class="logo" href="/">{site.name}</a>
  <nav class="filters" aria-label="Filters">
    <div class="filter">
      <button type="button" class="pill" aria-expanded="false" aria-controls="panel-filter" id="pill-filter">
        <span>Filter</span>
        <span class="pill-count" hidden />
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3.5l3 3 3-3" /></svg>
      </button>
      <div class="panel" id="panel-filter" role="group" aria-labelledby="pill-filter" hidden>
        <div class="panel-top">
          <button type="button" class="text-btn" id="deselect-all">Deselect all</button>
          <button type="button" class="text-btn" id="show-all">Show all</button>
        </div>
        {
          groups.map((g) => (
            <section class="filter-section" data-group={g.key} aria-label={g.label}>
              <div class="section-head">
                <h2 class="section-title">{g.label}</h2>
                <button type="button" class="text-btn" data-action="all">Select all</button>
                <button type="button" class="text-btn" data-action="clear">Clear</button>
              </div>
              {g.options.map((o) =>
                o.places ? (
                  <Fragment>
                    <label class="option is-country">
                      <input type="checkbox" data-country={o.id} data-leaves={o.places.map((pl) => pl.id).join(',')} checked />
                      <span class="option-label">{o.label}</span>
                      <span class="option-count" />
                    </label>
                    {o.places.map((pl) => (
                      <label class="option is-place">
                        <input type="checkbox" value={pl.id} checked />
                        <span class="option-label">{pl.label}</span>
                        <span class="option-count" />
                      </label>
                    ))}
                  </Fragment>
                ) : (
                  <label class="option">
                    <input type="checkbox" value={o.id} checked />
                    <span class="option-label">{o.label}</span>
                    <span class="option-count" />
                  </label>
                ),
              )}
            </section>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<main>
  <h1 class="visually-hidden">Photography by {site.name}</h1>
  <div class="grid" id="grid">
    {
      photos.map((p, i) => (
        <a class="tile" href={`/photo/${p.slug}`} data-i={i}>
          <picture>
            <source type="image/avif" srcset={srcset(p.images.thumb.avif)} sizes={TILE_SIZES} />
            <img
              src={p.images.thumb.webp[0].url}
              srcset={srcset(p.images.thumb.webp)}
              sizes={TILE_SIZES}
              alt={p.title}
              width="800"
              height="800"
              loading={i < 15 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </a>
      ))
    }
  </div>
  <div class="empty" id="empty" hidden>
    <p>No photos match these filters.</p>
    <button type="button" class="pill" id="reset">Show all photos</button>
  </div>
</main>

<footer class="footer">
  <span>&copy; {year} {site.name}</span>
  <a href={site.instagramUrl} rel="me noopener">Instagram</a>
</footer>

<div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label={open ? open.title : 'Photo'} hidden={!open}>
  <div class="viewer-bg"></div>
  <div class="stage" id="stage" style={open ? `--ar: ${open.ar}` : undefined}>
    <div class="zoom" id="zoom">
      <img class="stage-preview" id="stage-preview" alt="" src={open ? open.images.preview.url : undefined} />
      <picture>
        <source type="image/avif" id="stage-avif" srcset={open ? srcset(open.images.large.avif) : undefined} sizes="100vw" />
        <img
          class="stage-full"
          id="stage-full"
          alt={open ? open.title : ''}
          src={open ? open.images.large.webp[0].url : undefined}
          srcset={open ? srcset(open.images.large.webp) : undefined}
          sizes="100vw"
        />
      </picture>
    </div>
  </div>
  <a class="glass-btn viewer-close" id="viewer-close" href="/" aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
  </a>
  <a class="glass-btn viewer-prev" id="viewer-prev" href={prev ? `/photo/${prev.slug}` : '/'} aria-label="Previous photo">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.5 4l-6 6 6 6" /></svg>
  </a>
  <a class="glass-btn viewer-next" id="viewer-next" href={next ? `/photo/${next.slug}` : '/'} aria-label="Next photo">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 4l6 6-6 6" /></svg>
  </a>
  <div class="zoom-controls" id="zoom-controls">
    <button type="button" class="zoom-btn" id="zoom-out" aria-label="Zoom out" disabled>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 10h12" /></svg>
    </button>
    <button type="button" class="zoom-btn" id="zoom-in" aria-label="Zoom in">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 10h12M10 4v12" /></svg>
    </button>
  </div>
  <button
    type="button"
    class="glass-btn viewer-info"
    id="viewer-info"
    aria-label="Photo details"
    aria-expanded="false"
    aria-controls="info-panel"
    hidden={open ? !hasInfo : false}
  >
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="7.5" /><path d="M10 9v5" /><circle cx="10" cy="6.2" r="0.6" fill="currentColor" stroke="none" /></svg>
  </button>
  <div class="info-panel" id="info-panel" role="region" aria-label="Photo details" hidden={!hasInfo}>
    <dl>
      <div class="info-row" id="info-place" hidden={!openPlace}>
        <dt>Location</dt>
        <dd>{openPlace}</dd>
      </div>
      <div class="info-row" id="info-camera" hidden={!open?.source.camera}>
        <dt>Camera</dt>
        <dd>{open?.source.camera}</dd>
      </div>
      <div class="info-row" id="info-lens" hidden={!open?.source.lens}>
        <dt>Lens</dt>
        <dd>{open?.source.lens}</dd>
      </div>
    </dl>
  </div>
</div>

<script type="application/json" id="gallery-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />

<script>
  import '../scripts/gallery.ts';
</script>
