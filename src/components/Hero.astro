---
// Full-screen globe of all photos in front of the grid. Scrolling unrolls the
// globe into a sheet that settles into the gallery. Only on the home page
// without filters, with JavaScript and WebGL; otherwise the page is the grid.
---

<script is:inline>
  // Runs before the first paint, so the grid never jumps down when the hero appears.
  (function () {
    var q = new URLSearchParams(location.search);
    if (location.pathname !== '/' || ['loc', 'cat', 'year', 'style'].some(function (k) { return q.has(k); })) return;
    try {
      var c = document.createElement('canvas');
      var gl = c.getContext('webgl2') || c.getContext('webgl');
      if (!gl) return;
      var lose = gl.getExtension('WEBGL_lose_context');
      if (lose) lose.loseContext();
    } catch (e) {
      return;
    }
    document.documentElement.classList.add('hero', 'hero-on');
  })();
</script>

<section class="hero-space" id="hero" aria-label="Photo globe">
  <div class="hero-glow" aria-hidden="true"></div>
  <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-loader" id="hero-loader">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="hero-loader-track" cx="50" cy="50" r="49" pathLength="1"></circle>
      <circle class="hero-loader-arc" cx="50" cy="50" r="49" pathLength="1"></circle>
    </svg>
    <p class="hero-loader-text" id="hero-loader-text" role="status" aria-live="polite">Loading</p>
  </div>
  <div class="hero-hit" id="hero-hit" aria-hidden="true"></div>
  <button type="button" class="hero-pause" id="hero-pause" aria-pressed="false" aria-label="Pause the globe">
    <svg class="icon-pause" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="3" y="2.5" width="2.6" height="9" rx="0.8" /><rect x="8.4" y="2.5" width="2.6" height="9" rx="0.8" /></svg>
    <svg class="icon-play" width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M4.2 2.6v8.8a.6.6 0 0 0 .9.5l7-4.4a.6.6 0 0 0 0-1L5.1 2.1a.6.6 0 0 0-.9.5z" /></svg>
  </button>
  <div class="hero-bio" id="hero-bio">
    <p>Hi, I'm Dieter. I'm from Belgium, and I spend my time making music, taking photos, travelling and building things for the web. This site brings all of that together, so have a look around.</p>
  </div>
  <a class="hero-hint" id="hero-hint" href="#grid">
    <span>Scroll</span>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 5l4 4 4-4" /></svg>
  </a>
</section>

<script>
  import '../scripts/hero.ts';
</script>
